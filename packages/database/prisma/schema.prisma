datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  username                 String?
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  displayUsername          String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  createdRedeemCodeBatches RedeemCodeBatch[]            @relation("RedeemCodeBatchCreatedBy")
  redeemedCodes            RedeemCode[]                 @relation("RedeemCodeRedeemedBy")
  entitlementGrants        EntitlementGrant[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id                String        @id @default(cuid())
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
  type              PurchaseType
  provider          String        @default("stripe")
  claimStatus       String        @default("claimed")
  customerId        String
  customerEmail     String?
  subscriptionId    String?       @unique
  paymentLinkId     String?
  visitorId         String?
  attributionId     String?
  adPlatform        String?
  adClickId         String?
  adRecord          String?
  firstPaidPaymentId String?
  taliviaVisitorId  String?
  taliviaSessionId  String?
  priceId           String
  status            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([subscriptionId])
  @@index([customerEmail, claimStatus])
  @@index([visitorId])
  @@map("purchase")
}

model RedeemCodeBatch {
  id           String       @id @default(cuid())
  name         String
  planId       String
  durationDays Int
  quantity     Int
  redeemBefore DateTime?
  note         String?      @db.Text
  createdById  String
  createdBy    User         @relation("RedeemCodeBatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  codes        RedeemCode[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdById])
  @@index([redeemBefore])
  @@map("redeem_code_batch")
}

model RedeemCode {
  id               String            @id @default(cuid())
  batchId          String
  batch            RedeemCodeBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  code             String            @unique
  codeHash         String            @unique
  codePrefix       String
  status           String            @default("available")
  redeemedById     String?
  redeemedBy       User?             @relation("RedeemCodeRedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt       DateTime?
  entitlementGrant EntitlementGrant?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([redeemedById])
  @@map("redeem_code")
}

model EntitlementGrant {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemCodeId String?     @unique
  redeemCode   RedeemCode? @relation(fields: [redeemCodeId], references: [id], onDelete: SetNull)
  source       String
  planId       String
  durationDays Int
  startsAt     DateTime
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([startsAt])
  @@index([expiresAt])
  @@map("entitlement_grant")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

model Trader {
  id          String   @id @default(cuid())
  externalId  String   @unique
  name        String
  displayName String?
  avatarUrl   String?
  platform    String?
  handle      String?
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceBindings SignalSourceBinding[]
  signals     Signal[]

  @@index([name])
  @@map("trader")
}

model TradingSymbol {
  id             String   @id @default(cuid())
  symbol         String   @unique
  baseAsset      String
  quoteAsset     String
  exchange       String   @default("binance")
  displayName    String?
  logoUrl        String?
  pricePrecision Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  signals        Signal[]

  @@index([baseAsset])
  @@index([quoteAsset])
  @@map("trading_symbol")
}

model Signal {
  id               String   @id @default(cuid())
  eventId          String   @unique
  businessKey      String?  @unique
  traderId         String
  trader           Trader   @relation(fields: [traderId], references: [id])
  symbolId         String
  tradingSymbol    TradingSymbol @relation(fields: [symbolId], references: [id])
  direction        String
  entryStatus      String   @default("pending")
  status           String   @default("active")
  entry            Float
  takeProfit       Float?
  stopLoss         Float
  riskReward       Float
  submittedAt      DateTime
  chartPositionPct Float    @default(92)
  exchange         String?
  timeframe        String?
  outcome          String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([symbolId, status])
  @@index([traderId])
  @@index([submittedAt])
  @@map("signal")
}

// A checkout correlation, not a purchase. No email or payment credentials are stored here.
model CheckoutAttribution {
  id String @id
  provider String
  paymentLinkUrl String
  adPlatform String?
  adClickId String?
  adRecord String?
  taliviaVisitorId String?
  taliviaSessionId String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  utmContent String?
  utmTerm String?
  createdAt DateTime @default(now())
  @@index([provider, taliviaSessionId, createdAt])
  @@map("checkout_attribution")
}

model AdConversion {
  id String @id @default(cuid())
  provider String
  paymentId String
  attributionId String
  amountUsd String?
  amountMinor Int?
  currency String?
  adPlatform String?
  adClickId String?
  adRecord String?
  subscriptionId String?
  goal String @default("first_purchase")
  status String @default("pending")
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider, paymentId])
  @@unique([provider, attributionId])
  @@unique([provider, subscriptionId, goal])
  @@unique([adPlatform, adRecord, goal])
  @@map("ad_conversion")
}

// Server-only webhook audit records, accessible through admin procedures.
model SignalWebhookLog {
  id          String   @id
  mode        String   @default("single")
  status      String   @default("processing")
  httpStatus  Int?
  total       Int      @default(0)
  saved       Int      @default(0)
  ignored     Int      @default(0)
  invalid     Int      @default(0)
  failed      Int      @default(0)
  durationMs  Int?
  error       String?
  searchText  String   @default("")
  items       Json     @default("[]")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([createdAt, id])
  @@index([status, createdAt])
  @@map("signal_webhook_log")
}

model SignalSourceBinding {
  id String @id @default(cuid())
  platform String
  serverName String
  channelName String
  categoryName String @default("")
  platformKey String
  serverKey String
  channelKey String
  categoryKey String @default("")
  traderId String
  trader Trader @relation(fields: [traderId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformKey, serverKey, channelKey, categoryKey], map: "signal_source_binding_platformKey_serverKey_channelKey_category")
  @@index([traderId])
  @@map("signal_source_binding")
}
