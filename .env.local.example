# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
DIRECT_URL=""

# Sensitive server-only authentication credential for POST /api/signals/webhook.
# Set a strong random value in .env; send it as x-signal-webhook-secret. Never commit the value.
SIGNAL_WEBHOOK_SECRET=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://signalfast.localhost:4101"
NEXT_PUBLIC_SAAS_URL="http://signalfast.localhost:4100"

# Talivia analytics (use the development website ID/domain locally)
TALIVIA_WEBSITE_ID=""
TALIVIA_DOMAIN=""
TALIVIA_BOT_TOKEN=""

# Docs url
NEXT_PUBLIC_DOCS_URL="http://signalfast.localhost:4102"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
BETTER_AUTH_URL="http://signalfast.localhost:4100"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
MAIL_FROM="noreply@example.com"
CONTACT_EMAIL="your-admin@example.com"
# ... with Resend
RESEND_API_KEY=""

# Payments
# Payment provider credentials and webhook secrets (server-only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
YOLFI_WEBHOOK_SECRET=""
# Server-only AdsGram postback token. First purchase uses goaltype=2.
ADSGRAM_CONVERSION_TOKEN=""

# Public subscription checkout URLs (safe to expose in the client)
NEXT_PUBLIC_STRIPE_PRO_WEEKLY_PAYMENT_LINK="https://buy.stripe.com/test_00w14n0im0Ba0Zl3mffnO00"
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PAYMENT_LINK="https://buy.stripe.com/test_00w28rd580Ba0ZlbSLfnO01"
NEXT_PUBLIC_YOLFI_PRO_WEEKLY_PAYMENT_LINK="https://pay.yolfi.com/340ba658-394f-439c-9abc-36985d2383d3"
NEXT_PUBLIC_YOLFI_PRO_YEARLY_PAYMENT_LINK="https://pay.yolfi.com/75797130-8b5c-4814-8266-204472a4be16"

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
