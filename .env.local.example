# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# ... if you use Supabase
DIRECT_URL=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://signalfast.localhost:4101"
NEXT_PUBLIC_SAAS_URL="http://signalfast.localhost:4100"
# One shared Sentry project for SaaS, marketing, and docs.
NEXT_PUBLIC_SENTRY_DSN=""
# Use dev locally and prd in each production deployment.
NEXT_PUBLIC_SENTRY_ENVIRONMENT="dev"
# Required only in CI/deployment builds to upload source maps.
SENTRY_AUTH_TOKEN=""


# Docs url
NEXT_PUBLIC_DOCS_URL="http://signalfast.localhost:4102"
NEXT_PUBLIC_XIANYU_REDEEM_URL="https://www.goofish.com/search?q=SignalFast%20%E5%85%91%E6%8D%A2%E7%A0%81"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
BETTER_AUTH_URL="http://signalfast.localhost:4100"
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Mails
MAIL_FROM="noreply@example.com"
CONTACT_EMAIL="your-admin@example.com"
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Plunk
PLUNK_API_KEY=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""
# ... with QiXiang (WeChat Pay / Alipay for Chinese market – lifetime plan only)
# QIXIANG_API_URL defaults to https://api.payqixiang.cn/mapi.php; override here if the endpoint changes.
QIXIANG_API_URL="https://api.payqixiang.cn/mapi.php"
QIXIANG_PID=""
QIXIANG_KEY=""

# Product price IDs – one per payment method
# Credit card (Stripe price IDs)
PRICE_ID_PRO_MONTHLY_CARD="price_asdf1234"
PRICE_ID_PRO_YEARLY_CARD="price_asdf1234"
PRICE_ID_LIFETIME_CARD="price_asdf1234"
# WeChat Pay / Alipay via QiXiang – use synthetic internal identifiers (not Stripe IDs).
# These are stored in the database to map a purchase back to the lifetime plan.
PRICE_ID_LIFETIME_WECHAT="qixiang_lifetime_wechat"
PRICE_ID_LIFETIME_ALIPAY="qixiang_lifetime_alipay"

# Product prices and currencies – per payment method
# Amount is a plain integer (e.g. 29 for $29.00, 5999 for ¥5999). Currency is ISO 4217.
# NEXT_PUBLIC_ prefix is required so these values are available in client components.
# Credit card
NEXT_PUBLIC_PRICE_AMOUNT_PRO_MONTHLY_CARD=19.99
NEXT_PUBLIC_PRICE_CURRENCY_PRO_MONTHLY_CARD=CNY
NEXT_PUBLIC_PRICE_AMOUNT_PRO_YEARLY_CARD=168.88
NEXT_PUBLIC_PRICE_CURRENCY_PRO_YEARLY_CARD=CNY
NEXT_PUBLIC_PRICE_AMOUNT_LIFETIME_CARD=199.99
NEXT_PUBLIC_PRICE_CURRENCY_LIFETIME_CARD=CNY
# WeChat Pay (lifetime only – QiXiang)
NEXT_PUBLIC_PRICE_AMOUNT_LIFETIME_WECHAT=199.99
NEXT_PUBLIC_PRICE_CURRENCY_LIFETIME_WECHAT=CNY
# Alipay (lifetime only – QiXiang)
NEXT_PUBLIC_PRICE_AMOUNT_LIFETIME_ALIPAY=199.99
NEXT_PUBLIC_PRICE_CURRENCY_LIFETIME_ALIPAY=CNY

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
NEXT_PUBLIC_MIXPANEL_API_HOST="https://api-eu.mixpanel.com"
# Session Replay is disabled by default. The SDK masks all text and inputs by
# default; start at 100 only for controlled testing, then reduce the sample rate.
NEXT_PUBLIC_MIXPANEL_SESSION_REPLAY_PERCENT="0"
# Optional server-side project token used to update membership profiles. When
# omitted, the server falls back to NEXT_PUBLIC_MIXPANEL_TOKEN.
MIXPANEL_TOKEN=""
MIXPANEL_API_HOST="https://api-eu.mixpanel.com"
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
# For local development with Docker Compose (MinIO):
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"

# AI
# ... with OpenAI
OPENAI_API_KEY=""
